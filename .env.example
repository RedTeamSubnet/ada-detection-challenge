## --- Environment variable --- ##
ENV=LOCAL
DEBUG=false
# TZ=UTC
# PYTHONDONTWRITEBYTECODE=1


## -- API configs -- ##
# Template-level port used by compose port mapping.
AAD_CHALLENGE_API_PORT=10001

# AAD runtime API config consumed by the challenge process.
AAD_API_PORT=10001
# AAD_API_CONFIGS_DIR=/etc/rest-aad-challenge
# AAD_API_LOGS_DIR=/var/log/rest-aad-challenge
# AAD_API_DATA_DIR=/var/lib/rest-aad-challenge
# AAD_API_TMP_DIR=/tmp/rest-aad-challenge
# AAD_API_VERSION=1
# AAD_API_PREFIX=
# AAD_API_DOCS_ENABLED=true
# AAD_API_DOCS_OPENAPI_URL={api_prefix}/openapi.json
# AAD_API_DOCS_DOCS_URL={api_prefix}/docs
# AAD_API_DOCS_REDOC_URL={api_prefix}/redoc

AAD_CHALLENGE_API_KEY=challenge_api_key_here # YOU CAN IGNORE THIS FOR LOCAL TESTING BUT NOT REMOVE
AAD_CHALLENGE_VERIFICATION_API_KEY=verification_api_key_here # YOU CAN IGNORE THIS FOR LOCAL TESTING BUT NOT REMOVE
AAD_CHALLENGE_VERIFICATION_ENDPOINT=http://example.com/
AAD_CHALLENGE_VERIFICATION_STARTUP_URL=http://example.com/
## -- Bot Runner config -- ##
# Use a URL reachable from inside the challenge container.
# For a compose-network bot-runner service, use http://bot-runner:8080.
# For a host/remote bot-runner, use http://<bot-runner-host-ip>:8080.
# AAD_CHALLENGE_BOT_RUNNER__SERVERS=[{"url":"http://bot-runner-1:8080","device_type":"linux"},{"url":"http://bot-runner-2:8080","device_type":"mac"}]
# AAD_CHALLENGE_BOT_RUNNER__API_KEY=your_bot_runner_api_key
# Use a URL reachable by the browser running on the bot-runner host.
# Do not use localhost here unless bot-runner runs on the same host as the challenge port mapping.
# AAD_CHALLENGE_BOT_RUNNER__PUBLIC_BASE_URL=http://<challenge-host-ip>:10001
# AAD_CHALLENGE_BOT_RUNNER__BOT=aad-detect
